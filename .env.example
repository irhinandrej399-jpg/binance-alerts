DATABASE_URL=postgres://market:local-development-only@localhost:54329/market?sslmode=disable
SYMBOLS=BTCUSDT,ETHUSDT
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=market.prices.v1
HTTP_ADDR=127.0.0.1:8080
BATCH_SIZE=10
BATCH_TIMEOUT=60s
POLL_INTERVAL=100ms
RETRY_DELAY=1s
OUTBOX_RETENTION=24h
TRACKING_MODE=static
TRACKING_TOPIC=market.instrument-tracking.v1
TRACKING_GROUP=market-data.tracking.v1
TRACKING_REFRESH_INTERVAL=1s
